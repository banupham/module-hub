{
  "hub_version": "0.2.0",
  "modules": {
    "tiktok": {
      "name": "TikTok LIVE Middleware",
      "version": "active_viewers_v9",
      "repo": "banupham/tiktok_live_cmd_active_viewers_v9",
      "repo_key": "tiktok",
      "role": "input",
      "port_env": "API_PORT",
      "health_path": "/api/health",
      "start": {"default": ["cmd", "/c", "start_live.bat", "{username}"]},
      "env": {
        "COLLECTOR_MODE": "direct",
        "WEBHOOK_TIMEOUT_MS": "3000",
        "WEBHOOK_RETRY_COUNT": "1"
      }
    },
    "stt": {
      "name": "Google STT Bridge",
      "version": "2.6",
      "repo": "banupham/google-stt-bridge",
      "repo_key": "stt",
      "role": "input",
      "port_env": "STT_PORT",
      "health_path": "/health",
      "start": {
        "mic": ["cmd", "/c", "START_MIC.cmd"],
        "pc": ["cmd", "/c", "START_PC_AUDIO.cmd"],
        "server": ["cmd", "/c", "START_SERVER_ONLY.cmd"]
      }
    },
    "translate": {
      "name": "Google Translate RPC",
      "version": "2.0-final",
      "repo": "banupham/google-translate-rpc",
      "repo_key": "translate",
      "role": "processor",
      "port_env": "TRANSLATE_PORT",
      "health_path": "/health",
      "start": {"default": ["cmd", "/c", "START_API.cmd"]}
    },
    "tts_api": {
      "name": "Google TTS API",
      "version": "1.0",
      "repo": "banupham/google_loa_tts",
      "repo_key": "tts",
      "cwd_suffix": "tts_api",
      "role": "processor",
      "port_env": "TTS_API_PORT",
      "health_path": "/health",
      "start": {"default": ["cmd", "/c", "START_TTS_API.cmd"]}
    },
    "tts_speaker": {
      "name": "Google TTS Speaker",
      "version": "1.0",
      "repo": "banupham/google_loa_tts",
      "repo_key": "tts",
      "role": "output",
      "port_env": "LOA_API_PORT",
      "health_path": "/health",
      "start": {"default": ["cmd", "/c", "START_SPEAKER.cmd"]}
    }
  }
}
